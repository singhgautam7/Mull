<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same single include as backup_rules.xml, for cloud
     backup and for device-to-device transfer. See that file for why. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/mull_user.sqlite" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/mull_user.sqlite" />
    </device-transfer>
</data-extraction-rules>
