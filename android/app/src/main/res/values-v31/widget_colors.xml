<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the wallpaper-derived neutral palette, light tones. The
     system guarantees these tone steps, so contrast holds on any seed. -->
<resources>
    <color name="widget_panel">@android:color/system_neutral1_50</color>
    <color name="widget_outline">@android:color/system_neutral2_200</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_text_variant">@android:color/system_neutral2_700</color>
    <color name="widget_text_muted">@android:color/system_accent1_700</color>
</resources>
